    file[]: crc = 504086c1; size =    188954; name = DUKE.RTS
    file[]: crc = 4c4aaefd; size =   1076339; name = DUKE3D.EXE
    file[]: crc = 912e1e8d; size =  10442980; name = DUKE3D.GRP
