//
// v1.3D, Korean
//
game[v1.3d-kr]:
    name = v1.3D, Korean
    SETUP_VERSION = SetupVersion = "1.3D"
    imports = v1.3d
    anchorfile = DUKE3D.EXE
    file[]: crc = 399d5e57; size =   1179131; name = DUKE3D.1
    file[]: crc = 9eb379cf; size =      4000; name = DUKE3D.BIN
    file[]: crc = de647d35; size =      5313; name = DUKE3D.EXE
    file[]: crc = aa4f6a40; size =  26385383; name = DUKE3D.GRP
    file[]: crc = df938cf7; size =   1179131; name = DUKE3D.PRG
end

//
// v1.4, Plutonium Pack
//
upgrader[v1.4]:
    name = v1.4, Plutonium Pack
    upgradeids = v1.3d
    SETUP_VERSION = SetupVersion = "1.4"
    launch = INST.EXE
    anchorfile = INST.EXE
    file[]: crc = 7a4b1926; size =    144074; name = INST.EXE
    file[]: crc = 138977d8; size =     61311; name = PLUTINST\PATCH.EXE
    file[]: crc = 6b0a6153; size =       535; name = PLUTINST\PATCH.RTP
    file[]: crc = fe8d1d2e; size =  22083746; name = PLUTINST\PATCH1.RTP
    file[]: crc = 7ee75a8f; size =      2775; name = PLUTINST\PATCHME.EXE
end

//
// v1.5, Atomic Edition
//
game[v1.5]:
    name = v1.5, Atomic Edition
    SETUP_VERSION = SetupVersion = "1.4"
    ATOMIC = 1
    EXTRA_ATOMIC_CONFIGS = [[[$(CRLF)
        Shadows = 1
        Password = ""
        Detail = 1
        Tilt = 1
        Messages = 1
        Out = 0
        ScreenSize = 8
        ScreenGamma = 0
        ;
        SoundToggle = 1
        VoiceToggle = 1
        AmbienceToggle = 1
        MusicToggle = 1
        ;
        GameMouseAiming = 0
        AimingFlag = 0
        ;
