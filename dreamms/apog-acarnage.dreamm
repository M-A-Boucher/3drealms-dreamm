//
// Alien Carnage
//
desc[apog-acarnage]:

name = Alien Carnage
icon = apog-acarnage.png
machine = pc
osenv = dos
rootpath = C:\
launch = CARNAGE.EXE
mips = $(MIPS_486DX_33)
ramkb = 4096
filter = apogee software, action
audiohw = speaker

//
// graphics configuration
//
config[graphics]:
    title = Graphics Configuration
    option[vga]:
        name = $(VGA_NAME)
        videohw = vga
    end
end

// sound configuration
config[sound]:
    title = Sound Configuration
    option[speaker]:
        name = $(SPEAKER_NAME)
        audiohw = speaker
        AUDIO_CONFIG = 00 00 00 01 00 00 20 02 07 02 64 00 00 00 00 00 14
    end
    option[sb16]:
        name = $(SB16_NAME)
        audiohw = sb16
        AUDIO_CONFIG = 02 00 00 00 00 00 20 02 07 02 64 00 00 00 00 00 00
    end
end

script[init]:
    code = [[[$(CRLF)
        filepath = "$$(rootpath)\\HARRY.CFG";

        if (file_exists(filepath))
        {
          file = file_load_blob(file);
          blob_fill(file, 0, 1, "`h:$$(AUDIO_CONFIG)");
        }
        else
          file = blob_create("`h:$$(AUDIO_CONFIG) 00 02 01 01 00 00 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 00 00 01 00 4B 4D 48 50 38 1D 00 00 00 00 00");

        file_save(filepath, file);
    ]]]
end

//
// filesystem
//
mount[]: vpath = C:\        ; srcpath = $(ifsdeltapath)  ; writable = true;
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// v1.0, 2x1.44M 
//
game[v1.0]:
